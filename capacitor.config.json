{
  "appId": "com.sidajaya.chatshop",
  "appName": "Chat Sidajaya",
  "webDir": "www",
  "server": {
    "url": "https://chat.sidajaya.shop",
    "cleartext": false,
    "allowNavigation": [
      "chat.sidajaya.shop",
      "ai.sidajaya.shop",
      "labs.sidajaya.shop"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#6d28d9"
    }
  }
}